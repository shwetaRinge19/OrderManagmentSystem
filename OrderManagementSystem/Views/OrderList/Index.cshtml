@using OrderManagementSystem_Core.Models.OrderListModel
@model List<OrderListModel>

@{
    ViewData["Title"] = "Order Management";
}

<style>
    /* ===== SAFE PREMIUM STYLING ===== */
    .page-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
    }

    /* ===== TOTAL BAR ===== */
    .total-summary {
        background: linear-gradient(90deg, #198754, #157347);
        color: #fff;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        display: inline-block;
        min-width: 260px;
        text-align: center;
    }

    /* ===== TABLE ===== */
    .table th {
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .modal-content {
        border-radius: 14px;
    }
</style>

<div class="page-card">

    <h5 class="mb-3">Order Management</h5>

    <!-- ================= FILTER BAR ================= -->
    <form method="get" class="card shadow-sm mb-3">
    <div class="card-body">

        <div class="row align-items-end g-3">

            <!-- DATE FILTERS -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date"  
                       id="fromDate"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control form-control-sm" />
            </div>

            <!-- SEARCH + RESET -->
            <div class="col-md-3 d-flex">
                <button class="btn btn-primary btn-sm w-100 me-2">
                    <i class="bi bi-search me-1"></i> Search
                </button>

                <a class="btn btn-outline-secondary btn-sm"
                   href="@Url.Action("Index","OrderList")"
                   title="Reset filters and show all">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
            </div>

            <!-- RIGHT ACTIONS -->
            <div class="col-md-5 text-end">
                <div class="btn-group" role="group">

                    <a class="btn btn-outline-danger btn-sm px-3"
                       target="_blank"
                       href="@Url.Action("ExportPdf","OrderList",new{
                           agencyId=ViewBag.SelectedAgencyId,
                           fromDate=ViewBag.FromDate,
                           toDate=ViewBag.ToDate
                       })">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
                    </a>

                    <button type="button"
                            class="btn btn-success btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#billModal">
                        <i class="bi bi-plus-circle me-1"></i> New Bill
                    </button>

                    <button type="button"
                            class="btn btn-outline-success btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#agencyModal">
                        <i class="bi bi-building me-1"></i> Add Agency
                    </button>

                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#itemModal">
        <i class="bi bi-box-seam me-1"></i> Register Item (Ctrl+I)
    </button>

                </div>
            </div>

        </div>

                    @await Html.PartialAsync("_ItemMasterModal", new OrderManagementSystem_Core.Models.ItemCreateModel())

    </div>
</form>


    <!-- ================= TOTAL ================= -->
    @if (Model.Any())
    {
        <div class="d-flex justify-content-end mb-3">
            <div class="total-summary">
                Total Bill Amount : ₹ @ViewBag.GrandTotal
            </div>
        </div>
    }

    <!-- ================= ORDER LIST ================= -->
    @if (Model.Any())
    {
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Bill No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Total Amount</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
