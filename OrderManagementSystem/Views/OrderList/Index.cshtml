@using OrderManagementSystem_Core.Models.OrderListModel
@model List<OrderListModel>

@{
    ViewData["Title"] = "Order Management";
}

<style>
    /* ===== SAFE PREMIUM STYLING ===== */
    .page-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
    }

    /* ===== TOTAL BAR ===== */
    .total-summary {
        background: linear-gradient(90deg, #198754, #157347);
        color: #fff;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        display: inline-block;
        min-width: 260px;
        text-align: center;
    }

    /* ===== TABLE ===== */
    .table th {
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .modal-content {
        border-radius: 14px;
    }
</style>

<div class="page-card">

    <h5 class="mb-3">Order Management</h5>

    <!-- ================= FILTER BAR ================= -->
    <form method="get" class="card shadow-sm mb-3">
    <div class="card-body">

        <div class="row align-items-end g-3">

            <!-- DATE FILTERS -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control form-control-sm" />
            </div>

            <!-- SEARCH -->
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>

            <!-- RIGHT ACTIONS -->
            <div class="col-md-6 text-end">
                <div class="btn-group" role="group">

                    <a class="btn btn-outline-danger btn-sm px-3"
                       target="_blank"
                       href="@Url.Action("ExportPdf","OrderList",new{
                           agencyId=ViewBag.SelectedAgencyId,
                           fromDate=ViewBag.FromDate,
                           toDate=ViewBag.ToDate
                       })">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
                    </a>

                    <button type="button"
                            class="btn btn-success btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#billModal">
                        <i class="bi bi-plus-circle me-1"></i> New Bill
                    </button>

                    <button type="button"
                            class="btn btn-outline-success btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#agencyModal">
                        <i class="bi bi-building me-1"></i> Add Agency
                    </button>

                </div>
            </div>

        </div>

    </div>
</form>


    <!-- ================= TOTAL ================= -->
    @if (Model.Any())
    {
        <div class="d-flex justify-content-end mb-3">
            <div class="total-summary">
                Total Bill Amount : ₹ @ViewBag.GrandTotal
            </div>
        </div>
    }

    <!-- ================= ORDER LIST ================= -->
    @if (Model.Any())
    {
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Bill No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Total Amount</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.BillNo</td>
                        <td>@order.BillDate?.ToString("dd-MM-yyyy")</td>
                        <td>@order.CustomerName</td>
                        <td>₹ @order.TotalAmount</td>
                        <td class="text-center">

    <div class="btn-group btn-group-sm">

        <button class="btn btn-outline-primary"
                data-bs-toggle="collapse"
                data-bs-target="#d_@order.Id">
            View
        </button>

       <a class="btn btn-outline-danger"
           target="_blank"
           href="@Url.Action("ExportSinglePdf","OrderList",
                new { id = order.Id })">
            PDF
        </a>

    </div>

</td>

                    </tr>

                    <tr class="collapse bg-light" id="d_@order.Id">
                        <td colspan="4">
                            <table class="table table-sm mt-2">
                                <thead class="table-warning text-center">
                                    <tr>
                                        <th>Item</th>
                                        <th width="160">Agency</th>
                                        <th>Qty</th>
                                        <th>Rate</th>
                                        <th>Disc %</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody class="text-center">
                                    @foreach (var item in order.SalesDetail)
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td>@item.AgencyName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Rate</td>
                                            <td>@item.DiscountRate</td>
                                            <td>@item.Amount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (ViewBag.SelectedAgencyId != null)
    {
        <p class="text-muted">No orders found.</p>
    }
</div>

<!-- ================= AGENCY MODAL ================= -->
<div class="modal fade" id="agencyModal">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Agency" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h6 class="modal-title">Add Agency</h6>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input name="agencyName"
                           class="form-control"
                           placeholder="Agency Name"
                           required />
                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary btn-sm px-4">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ================= BILL MODAL ================= -->
<div class="modal fade" id="billModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <form asp-controller="OrderList" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="AgencyId"
                       value="@ViewBag.SelectedAgencyId" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Create Bill</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Bill No</label>
                            <input name="BillNo"
                                   value="@ViewBag.BillNo"
                                   class="form-control form-control-sm"
                                   readonly />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Bill Date</label>
                            <input type="date"
                                   name="BillDate"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Customer Name</label>
                            <input type="text"
                                   name="CustomerName"
                                   class="form-control form-control-sm" />
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle text-center">
                            <thead class="table-light">
    <tr>
        <th width="150">Item</th>
        <th width="160">Agency</th>   <!-- ✅ ADD THIS -->
        <th width="80">Qty</th>
        <th width="100">Rate</th>
        <th width="90">Disc %</th>
        <th width="110">Amount</th>
        <th width="40"></th>
    </tr>
</thead>


                            <tbody id="itemBody">
                                <tr>
    <td>
        <input name="SalesDetail[0].ItemName"
               class="form-control form-control-sm" required />
    </td>

    <td>
        <select name="SalesDetail[0].AgencyId"
                class="form-select form-select-sm">
            <option value="">Select</option>
            @foreach (var agency in ViewBag.Agencies)
            {
                <option value="@agency.Id">@agency.AgencyName</option>
            }
        </select>
    </td>

    <td>
        <input name="SalesDetail[0].Quantity"
               min="1"
               type="number"
               class="form-control form-control-sm"
               oninput="calc(this)" required />
    </td>

    <td>
        <input name="SalesDetail[0].Rate"
               min="0"
               type="number"
               step="0.01"
               class="form-control form-control-sm"
               oninput="calc(this)" required />
    </td>

    <td>
        <input name="SalesDetail[0].DiscountRate"
               type="number"
               step="0.01"
               min="0"
               max="100"
               class="form-control form-control-sm"
               oninput="calc(this)" />
    </td>

    <td>
        <input name="SalesDetail[0].Amount"
               class="form-control form-control-sm"
               readonly />
    </td>

    <td>
        <button type="button"
                class="btn btn-sm btn-danger"
                onclick="removeRow(this)">✕</button>
    </td>
</tr>

                            </tbody>
                        </table>
                <!-- TOTAL ROW -->
                    <div class="d-flex justify-content-end align-items-center 
                                border-top px-3 py-2 bg-light">

                        <span class="fw-semibold me-3">Total Amount</span>

                        <input type="text"
                               id="totalAmount"
                               name="TotalAmount"
                               class="form-control form-control-sm text-end fw-bold"
                               style="max-width: 160px;"
                               readonly />
                    </div>

                    </div>

                    <div class="mt-3">
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                onclick="addRow()">
                            + Add Item
                        </button>
                    </div>


                </div>

                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-success btn-sm px-4"
                            onclick="return validateBillForm();">
                        Save Bill
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ================= STATUS MODAL ================= -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center">

            <div class="modal-body py-4">
                <div id="statusIcon" class="mb-3 fs-1"></div>
                <h6 id="statusMessage"></h6>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-primary btn-sm px-4"
                        data-bs-dismiss="modal">
                    OK
                </button>
            </div>

        </div>
    </div>
</div>
<input type="hidden" id="billStatus" value="@TempData["BillStatus"]" />
<input type="hidden" id="billMessage" value="@TempData["BillMessage"]" />

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {
        debugger
        const status = document.getElementById("billStatus")?.value;
        const message = document.getElementById("billMessage")?.value;

        if (!status || status === "") return;

        const icon = document.getElementById("statusIcon");
        const msg = document.getElementById("statusMessage");

        if (status === "success") {
            icon.innerHTML = "✅";
            msg.innerText = message || "Operation completed successfully.";
        }
        else {
            icon.innerHTML = "❌";
            msg.innerText = message || "Something went wrong.";
        }

        const modalElement = document.getElementById("statusModal");
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    });

    let rowIndex = 1;

    function getAgencyOptions() {
    return `
        ${Array.from(document.querySelectorAll("select[name='SalesDetail[0].AgencyId'] option"))
            .map(o => `<option value="${o.value}">${o.text}</option>`)
            .join("")}
    `;
}

    function addRow() {
        const body = document.getElementById("itemBody");
        if (!body) return;

        const row = document.createElement("tr");

        row.innerHTML = `

            <td>
                <input name="SalesDetail[${rowIndex}].ItemName"
                       class="form-control form-control-sm" required />
            </td>
            <td>
    <select name="SalesDetail[${rowIndex}].AgencyId"
            class="form-select form-select-sm">
        <option value="">Select</option>
        ${getAgencyOptions()}
    </select>
</td>
            <td>
                <input name="SalesDetail[${rowIndex}].Quantity"
                       type="number"
                       min="1"
                       class="form-control form-control-sm"
                       oninput="calc(this)"
                       required />
            </td>
            <td>
                <input name="SalesDetail[${rowIndex}].Rate"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control form-control-sm"
                       oninput="calc(this)"
                       required />
            </td>
            <td>
                <input name="SalesDetail[${rowIndex}].DiscountRate"
                       type="number"
                       step="0.01"
                       min="0"
                       max="100"
                       class="form-control form-control-sm"
                       oninput="calc(this)" />
            </td>

            <td>
                <input name="SalesDetail[${rowIndex}].Amount"
                       class="form-control form-control-sm"
                       readonly />
            </td>
            <td>
                <button type="button"
                        class="btn btn-sm btn-danger"
                        onclick="removeRow(this)">
                    ✕
                </button>
            </td>
        `;

        body.appendChild(row);
        rowIndex++;
    }

    function calc(el) {
        const row = el.closest("tr");
        if (!row) return;

        const qty = parseFloat(row.querySelector('[name$=".Quantity"]').value) || 0;
        const rate = parseFloat(row.querySelector('[name$=".Rate"]').value) || 0;
        const disc = parseFloat(row.querySelector('[name$=".DiscountRate"]').value) || 0;

        let amount = qty * rate;

        if (disc > 0) {
            amount -= (amount * disc / 100);
        }

        row.querySelector('[name$=".Amount"]').value = amount.toFixed(2);

        calculateTotal();
    }

    function calculateTotal() {
        let total = 0;

        document.querySelectorAll('[name$=".Amount"]').forEach(a => {
            total += parseFloat(a.value) || 0;
        });

        document.getElementById("totalAmount").value = total.toFixed(2);
    }

    function removeRow(btn) {
        btn.closest("tr").remove();
        calculateTotal();
    }
    function validateBillForm() {
    const rows = document.querySelectorAll("#itemBody tr");

    if (rows.length === 0) {
        alert("Please add at least one item.");
        return false;
    }

    for (let i = 0; i < rows.length; i++) {

        const agencySelect = rows[i].children[1].querySelector("select");
        const qtyInput = rows[i].children[2].querySelector("input");
        const rateInput = rows[i].children[3].querySelector("input");
        const discInput = rows[i].children[4].querySelector("input");

        // if (!agencySelect.value) {
        //     alert(`Row ${i + 1}: Please select an agency.`);
        //     agencySelect.focus();
        //     return false;
        // }

        const qty = parseFloat(qtyInput.value);
        const rate = parseFloat(rateInput.value);
        const disc = parseFloat(discInput.value) || 0;

        if (!qty || qty <= 0) {
            alert(`Row ${i + 1}: Quantity must be greater than 0.`);
            qtyInput.focus();
            return false;
        }

        if (isNaN(rate)) {
            alert(`Row ${i + 1}: Rate is mandatory.`);
            rateInput.focus();
            return false;
        }

        if (disc < 0 || disc > 100) {
            alert(`Row ${i + 1}: Discount must be between 0 and 100.`);
            discInput.focus();
            return false;
        }
    }

    return true;
}

</script>
}
