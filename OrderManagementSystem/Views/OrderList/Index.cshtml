<input type="hidden" id="billStatus" value="@TempData["BillStatus"]" />
<input type="hidden" id="billMessage" value="@TempData["BillMessage"]" />

@* <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script> *@
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function () {
        debugger
        const status = document.getElementById("billStatus")?.value;
        const message = document.getElementById("billMessage")?.value;

        if (!status || status === "") return;

        const icon = document.getElementById("statusIcon");
        const msg = document.getElementById("statusMessage");

        if (status === "success") {
            icon.innerHTML = "✅";
            msg.innerText = message || "Operation completed successfully.";
        }
        else {
            icon.innerHTML = "❌";
            msg.innerText = message || "Something went wrong.";
        }

        const modalElement = document.getElementById("statusModal");
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    });

    let rowIndex = 1;

    function getAgencyOptions() {
    return `
        ${Array.from(document.querySelectorAll("select[name='SalesDetail[0].AgencyId'] option"))
            .map(o => `<option value="${o.value}">${o.text}</option>`)
            .join("")}
    `;
}

    function addRow() {
        const body = document.getElementById("billItemBody") || document.getElementById("itemBody");
        if (!body) return;

        const row = document.createElement("tr");

        const agencyOptionsHtml = getAgencyOptions();

        row.innerHTML = `
<td>
    <div class="input-group input-group-sm">
        <input name="SalesDetail[0].Barcode"
               class="form-control form-control-sm barcode-input"
               data-mode="lookup"
               placeholder="Scan..."
               autocomplete="off"
               onkeydown="onBarcodeKeydown(event, this)" />
        <button type="button" class="btn btn-outline-secondary"
                onclick="openCameraScanner('bill', this.previousElementSibling)">
            <i class="bi bi-camera"></i>
        </button>
    </div>
    <input type="hidden" name="SalesDetail[0].ItemId" />
</td>
    <td>
        <input name="SalesDetail[${rowIndex}].ItemName"
               class="form-control form-control-sm" required />
    </td>
    <td>
        <select name="SalesDetail[${rowIndex}].AgencyId" class="form-select form-select-sm">
            <option value="">Select</option>
            ${agencyOptionsHtml}
        </select>
    </td>
    <td>
        <input name="SalesDetail[${rowIndex}].Quantity" type="number" min="1"
               class="form-control form-control-sm" oninput="calc(this)" required />
    </td>
    <td>
        <input name="SalesDetail[${rowIndex}].Rate" type="number" step="0.01" min="0"
               class="form-control form-control-sm" oninput="calc(this)" required />
    </td>
    <td>
        <input name="SalesDetail[${rowIndex}].DiscountRate" type="number" step="0.01" min="0" max="100"
               class="form-control form-control-sm" oninput="calc(this)" />
    </td>
    <td>
        <input name="SalesDetail[${rowIndex}].Amount" class="form-control form-control-sm" readonly />
    </td>
    <td>
        <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">✕</button>
    </td>
`;

        // append once
        body.appendChild(row);

        // auto-focus the new row's barcode field for continuous scanning
        row.querySelector('.barcode-input')?.focus();

        rowIndex++;
    }

    // ===== Barcode → Item lookup =====
async function lookupBarcode(barcode, row) {
    debugger
    if (!barcode) return;

    try {
        console.log('Lookup barcode:', barcode);
        const res = await fetch(`/OrderList/GetItemByBarcode?barcode=${encodeURIComponent(barcode)}`);

        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.message || `No item found for barcode: ${barcode}`);
            // row.querySelector('.barcode-input').select();
            return;
        }

        const item = await res.json();
        console.log('Item found:', item);
        
        // Get inputs - be more specific with selectors for dynamically added rows
        const inputs = row.querySelectorAll('input[type="text"], input[type="number"], select');
        
        if (inputs.length > 0) {
            // Typically: Barcode input[0], ItemName input[1], Quantity input[2], Rate input[3]
            // For bill modal: Barcode[0], ItemName[1], Quantity[2], Rate[3], Discount[4]
            
            const itemNameInput = row.querySelector('input[name*="ItemName"]');
            const rateInput = row.querySelector('input[name*="Rate"]');
            const qtyInput = row.querySelector('input[name*="Quantity"]');
            const agencySelect = row.querySelector('select[name*="AgencyId"]');
            const itemIdInput = row.querySelector('input[name*="ItemId"]');

            if (itemNameInput) {
                itemNameInput.value = item.itemName || '';
                console.log('ItemName set:', item.itemName);
            }
            if (rateInput) {
                rateInput.value = item.rate ?? '';
                console.log('Rate set:', item.rate);
            }
            if (agencySelect && item.agencyId) {
                agencySelect.value = item.agencyId;
                console.log('Agency set:', item.agencyId);
            }
            if (itemIdInput && item.id) {
                itemIdInput.value = item.id;
                console.log('ItemId set:', item.id);
            }

            // Auto-set quantity to 1 if empty
            if (qtyInput && !qtyInput.value) {
                qtyInput.value = 1;
            }

            // Recalculate amount
            if (qtyInput) {
                calc(qtyInput);
                qtyInput.focus();
                qtyInput.select();
            }
        }
    } catch (e) {
        console.error('Lookup error:', e);
        alert("Error looking up barcode. Please try again.");
    }
}

// Hardware scanner: Enter key fires lookup for that row
function onBarcodeKeydown(event, input) {
    if (event.key !== 'Enter') return;
    event.preventDefault();

    const mode = input.dataset.mode;

    if (mode === 'register') {
        // Item Register modal: just accept the scanned code as-is.
        // No lookup — this barcode is being newly assigned.
        input.value = input.value.trim();
        input.nextElementSibling?.focus(); // move to next field, e.g. Item Name
        return;
    }

    // default = Bill modal: look up an existing item
    const row = input.closest('tr');
    lookupBarcode(input.value.trim(), row);
}
// ===== Camera scanner (mode-aware) =====
let html5QrCode = null;
let scanTimeoutId = null;
let scannerMode = 'bill'; // 'bill' | 'register'
let scannerTargetInput = null; // used only in 'register' mode
const SCAN_TIMEOUT_MS = 10000;

// mode = 'bill'    -> looks up item, adds a bill row (POS-style)
// mode = 'register' -> just writes the decoded code into the given barcode field
function openCameraScanner(mode = 'bill', targetInputEl = null) {
    scannerMode = mode;
    scannerTargetInput = targetInputEl;

        const modalEl = document.getElementById('cameraModal');
    if (!modalEl) { alert('Camera modal not found'); return; }

    // Move the modal to the body root so it isn't trapped inside
    // billModal's DOM tree (a nested modal can otherwise fail to render).
    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    modalEl.addEventListener('shown.bs.modal', function handler() {
        modalEl.removeEventListener('shown.bs.modal', handler);

        // let Bootstrap's fade transition fully settle before measuring the container
        setTimeout(() => {
            try {
                html5QrCode = new Html5Qrcode("cameraReader", { verbose: true }); // verbose logs decode attempts to console

                html5QrCode.start(
                    { facingMode: "environment" },
                    {
                        fps: 10,
                        // NOTE: no `aspectRatio` — let the camera use its native stream shape.
                        // Forcing 16:9 on a camera that streams 4:3 (very common on laptops/webcams)
                        // is what caused the letterboxing / misaligned box you saw.
                        qrbox: (viewfinderWidth, viewfinderHeight) => {
                            const minEdge = Math.min(viewfinderWidth, viewfinderHeight);
                            const boxWidth = Math.floor(minEdge * 0.9);
                            const boxHeight = Math.floor(boxWidth * 0.45); // wide rectangle for 1D barcodes
                            return { width: boxWidth, height: boxHeight };
                        },
                        formatsToSupport: mode === 'register'
                            ? [
                                Html5QrcodeSupportedFormats.EAN_13,
                                Html5QrcodeSupportedFormats.UPC_A,
                                Html5QrcodeSupportedFormats.UPC_E,
                                Html5QrcodeSupportedFormats.EAN_8,
                                Html5QrcodeSupportedFormats.CODE_128,
                                Html5QrcodeSupportedFormats.CODE_39
                            ]
                            : [
                                Html5QrcodeSupportedFormats.EAN_13,
                                Html5QrcodeSupportedFormats.CODE_128,
                                Html5QrcodeSupportedFormats.UPC_A,
                                Html5QrcodeSupportedFormats.UPC_E,
                                Html5QrcodeSupportedFormats.EAN_8,
                                Html5QrcodeSupportedFormats.CODE_39
                            ],
                            experimentalFeatures: {
            useBarCodeDetectorIfSupported: true   // <-- add this
        }
                    },
                    onScanSuccess,
                    (errorMessage) => { /* per-frame decode miss, expected constantly while aiming */ }
                ).then(() => {
                    startScanTimeout();
                }).catch(err => {
                    console.error('Camera start error:', err);
                    alert('Could not start camera scanner:\n' + err.message);
                    closeCameraModal();
                });
            } catch (ex) {
                console.error('Scanner init error:', ex);
                alert('Camera scanner initialization failed: ' + ex.message);
            }
        }, 250); // give the modal fade-in time to finish sizing #cameraReader
    }, { once: true });
}

function startScanTimeout() {
    clearScanTimeout();
    scanTimeoutId = setTimeout(() => {
        stopCameraScanner();
        closeCameraModal();
        alert("No barcode detected within 10 seconds. Please try again.");
    }, SCAN_TIMEOUT_MS);
}

function clearScanTimeout() {
    if (scanTimeoutId) {
        clearTimeout(scanTimeoutId);
        scanTimeoutId = null;
    }
}

// Looks up an item by barcode. Returns { ok: true, item } or { ok: false, message }.
// Never touches the DOM — just fetches and reports.
async function fetchItemByBarcode(barcode) {
    if (!barcode) return { ok: false, message: 'Barcode is required.' };

    try {
        const res = await fetch(`/OrderList/GetItemByBarcode?barcode=${encodeURIComponent(barcode)}`);

        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            return { ok: false, message: err.message || `No item found for barcode: ${barcode}` };
        }

        const item = await res.json();
        return { ok: true, item };
    } catch (e) {
        console.error('Lookup error:', e);
        return { ok: false, message: 'Error looking up barcode. Please try again.' };
    }
}

// Fills an existing row's fields from an item object. Assumes the row already exists.
function populateRowWithItem(row, item) {
    const itemNameInput = row.querySelector('input[name*="ItemName"]');
    const rateInput = row.querySelector('input[name*="Rate"]');
    const qtyInput = row.querySelector('input[name*="Quantity"]');
    const agencySelect = row.querySelector('select[name*="AgencyId"]');
    const itemIdInput = row.querySelector('input[name*="ItemId"]');

    if (itemNameInput) itemNameInput.value = item.itemName || '';
    if (rateInput) rateInput.value = item.rate ?? '';
    if (agencySelect && item.agencyId) agencySelect.value = item.agencyId;
    if (itemIdInput && item.id) itemIdInput.value = item.id;

    if (qtyInput && !qtyInput.value) qtyInput.value = 1;
    if (qtyInput) {
        calc(qtyInput);
        qtyInput.focus();
        qtyInput.select();
    }
}


let isProcessingScan = false; // re-entrancy guard

async function onScanSuccess(decodedText) {
    if (isProcessingScan) return; // a scan is already being handled — ignore this duplicate trigger
    isProcessingScan = true;
    clearScanTimeout();
    if (!html5QrCode) { isProcessingScan = false; return; }
    try { await html5QrCode.pause(true); } catch (e) { /* ignore */ }
    const code = decodedText?.trim();
    console.log('DECODED:', code, 'mode:', scannerMode);
    try {
        if (scannerMode === 'register') {
            if (scannerTargetInput) {
                scannerTargetInput.value = code;
                scannerTargetInput.dispatchEvent(new Event('input', { bubbles: true }));
                document.getElementById('itemNameInput')?.focus(); // <-- changed from nextElementSibling?.focus()
            }
            stopCameraScanner();
            closeCameraModal();
            return;
        }
        const result = await fetchItemByBarcode(code);
        if (!result.ok) {
            alert(result.message || `No item found for barcode: ${code}`);
            try {
                await html5QrCode.resume();
                startScanTimeout();
            } catch (e) {
                stopCameraScanner();
                closeCameraModal();
            }
            return;
        }
        addRow();
        const rows = document.querySelectorAll("#billItemBody tr");
        const newRow = rows[rows.length - 1];
        const barcodeInput = newRow.querySelector('.barcode-input');
        if (barcodeInput) barcodeInput.value = code;
        populateRowWithItem(newRow, result.item);
        stopCameraScanner();
        closeCameraModal();
    } finally {
        isProcessingScan = false; // release the guard once this scan is fully handled
    }
}

function closeCameraModal() {
    const modalInstance = bootstrap.Modal.getInstance(document.getElementById('cameraModal'));
    if (modalInstance) modalInstance.hide();
}

function stopCameraScanner() {
    clearScanTimeout();
    isProcessingScan = false; // reset guard
    if (html5QrCode) {
        const instance = html5QrCode;
        html5QrCode = null;
        instance.stop().then(() => instance.clear()).catch(() => {});
    }
}

document.getElementById('cameraModal')?.addEventListener('hidden.bs.modal', function () {
    stopCameraScanner();
});

    function calc(el) {
        const row = el.closest("tr");
        if (!row) return;

        const qty = parseFloat(row.querySelector('[name$=".Quantity"]').value) || 0;
        const rate = parseFloat(row.querySelector('[name$=".Rate"]').value) || 0;
        const disc = parseFloat(row.querySelector('[name$=".DiscountRate"]').value) || 0;

        let amount = qty * rate;

        if (disc > 0) {
            amount -= (amount * disc / 100);
        }

        row.querySelector('[name$=".Amount"]').value = amount.toFixed(2);

        calculateTotal();
    }

    function calculateTotal() {
        let total = 0;

        document.querySelectorAll('[name$=".Amount"]').forEach(a => {
            total += parseFloat(a.value) || 0;
        });

        document.getElementById("totalAmount").value = total.toFixed(2);
    }

    function removeRow(btn) {
        btn.closest("tr").remove();
        calculateTotal();
    }
    function validateBillForm() {
    const rows = document.querySelectorAll("#itemBody tr");

    if (rows.length === 0) {
        alert("Please add at least one item.");
        return false;
    }

    for (let i = 0; i < rows.length; i++) {

        const agencySelect = rows[i].children[1].querySelector("select");
        const qtyInput = rows[i].children[2].querySelector("input");
        const rateInput = rows[i].children[3].querySelector("input");
        const discInput = rows[i].children[4].querySelector("input");

        // if (!agencySelect.value) {
        //     alert(`Row ${i + 1}: Please select an agency.`);
        //     agencySelect.focus();
        //     return false;
        // }

        const qty = parseFloat(qtyInput.value);
        const rate = parseFloat(rateInput.value);
        const disc = parseFloat(discInput.value) || 0;

        if (!qty || qty <= 0) {
            alert(`Row ${i + 1}: Quantity must be greater than 0.`);
            qtyInput.focus();
            return false;
        }

        if (isNaN(rate)) {
            alert(`Row ${i + 1}: Rate is mandatory.`);
            rateInput.focus();
            return false;
        }

        if (disc < 0 || disc > 100) {
            alert(`Row ${i + 1}: Discount must be between 0 and 100.`);
            discInput.focus();
            return false;
        }
    }

    return true;
}

