@using OrderManagementSystem_Core.Models.OrderListModel
@model OrderReportPdfVM
@{
    Layout = null;
}

<style>
    body {
        font-family: Arial;
        font-size: 11px;
        margin: 10px;
        color: #000;
    }

    h2, h3 {
        margin: 0;
    }

    .header {
        text-align: center;
        margin-bottom: 6px;
    }

    .period {
        font-size: 10px;
        margin-top: 2px;
    }

    .summary {
        width: 100%;
        margin-bottom: 8px;
        font-size: 11px;
    }

        .summary td {
            padding: 2px 4px;
        }

    .bill {
        margin-bottom: 8px;
        page-break-inside: avoid;
    }

    .bill-header {
        width: 100%;
        font-size: 11px;
        margin-bottom: 3px;
    }

        .bill-header td {
            padding: 2px 4px;
        }

    .items {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .items th,
        .items td {
            border: 1px solid #ccc;
            padding: 3px 4px;
        }

        .items th {
            background: #f2f2f2;
        }

    .right {
        text-align: right;
    }

    .center {
        text-align: center;
    }
</style>

<!-- Header -->
<div class="header">
    <h3>Keshav Medical Store</h3>
    <b>BILL REPORT</b>
    <div class="period">
        Period: @Model.FromDate to @Model.ToDate
    </div>
</div>

<!-- Summary -->
<table class="summary">
    <tr>
        <td><b>Total Amount:</b> ₹ @Model.GrandTotal</td>
    </tr>
</table>

<!-- Bills -->
@foreach (var order in Model.Orders)
{
    <div class="bill">

        <table class="bill-header">
            <tr>
                <td><b>Bill:</b> @order.BillNo</td>
                <td><b>Customer:</b> @order.CustomerName</td>
                <td><b>Date:</b> @order.BillDate?.ToString("dd-MM-yyyy")</td>
                <td class="right">
                    <b>Total:</b> ₹ @order.TotalAmount?.ToString("0.00")
                </td>
            </tr>
        </table>

        <table class="items">
            <thead>
                <tr>
                    <th width="55%">Item</th>
                    <th width="15%" class="center">Qty</th>
                    <th width="30%" class="right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in order.SalesDetail)
                {
                    <tr>
                        <td>@item.ItemName</td>
                        <td class="center">@item.Quantity</td>
                        <td class="right">@item.Amount?.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
